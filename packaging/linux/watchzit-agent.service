[Unit]
Description=WatchZit Agent
Documentation=https://github.com/Max-Zit/watchzit
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/watchzit-agent

[Service]
ExecStart=/usr/bin/watchzit-agent run
Restart=always
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target
