# WatchZit server configuration. Restart after changes:
#   systemctl restart watchzit-server

# PostgreSQL connection (required; install.sh fills it in).
WATCHZIT_DB=postgres://watchzit:CHANGE_ME@127.0.0.1:5432/watchzit?sslmode=disable

# Where updates come from (default: the official GitHub releases). A mirror
# or a local directory (file:///srv/watchzit-releases) holds the files of
# a release side by side; they must still carry the release signature.
#WATCHZIT_UPDATE_SOURCE=
